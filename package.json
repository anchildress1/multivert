{
  "name": "multivert",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "Multivert personality quiz — five types, multi-axis scoring, deployed on Cloudflare Pages.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "body-parser@<1.20.6": "1.20.6",
      "brace-expansion@5.0.5": "5.0.6",
      "cookie@<0.7.0": "0.7.2",
      "esbuild": "0.28.1",
      "js-yaml@<4.3.2": "4.3.2",
      "sharp@<0.35.4": "0.35.4",
      "tmp@<0.2.7": "0.2.7",
      "undici@<7.29.0": "7.29.0",
      "uuid@<14.0.0": "14.0.0",
      "ws@7.5.10": "7.5.11",
      "basic-ftp@<6.2.1": "6.2.1",
      "fast-uri@<3.1.8": "3.1.8",
      "ip-address@<10.7.1": "10.7.1",
      "qs@<6.16.0": "6.16.0"
    }
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "10.34.7"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "perf": "pnpm perf:mobile && pnpm perf:desktop",
    "perf:mobile": "lhci autorun --config=.lighthouserc.mobile.json",
    "perf:desktop": "lhci autorun --config=.lighthouserc.desktop.json",
    "secret-scan": "gitleaks git --pre-commit --staged --redact"
  },
  "devDependencies": {
    "@checkmarkdevtools/commitlint-plugin-rai": "^0.1.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/eslint-config": "^10.0.4",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
